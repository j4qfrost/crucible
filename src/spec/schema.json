{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crucible.dev/schema/mdspec-0.2.0.json",
  "title": "MDSpec",
  "description": "Molecular-dynamics simulation intermediate representation. Emitted by the LLM transpiler; consumed by Crucible backends.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "force_field", "protocol", "observables", "provenance", "warnings", "notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.2.0"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "n_atoms_estimate", "has_ligand", "solvent"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type":          {"enum": ["user_supplied", "pdb_id", "pdb_fetch", "smiles", "protein_ligand"]},
            "topology":      {"type": ["string", "null"]},
            "coordinates":   {"type": ["string", "null"]},
            "pdb_id":        {"type": ["string", "null"]},
            "ligand_smiles": {"type": ["string", "null"]}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "smiles"}}},
              "then": {"required": ["ligand_smiles"], "properties": {"ligand_smiles": {"type": "string", "minLength": 1}}}
            },
            {
              "if": {"properties": {"type": {"const": "protein_ligand"}}},
              "then": {
                "required": ["pdb_id", "ligand_smiles"],
                "properties": {
                  "pdb_id":        {"type": "string", "minLength": 4},
                  "ligand_smiles": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        },
        "n_atoms_estimate": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "has_ligand": {"type": "boolean"},
        "protonation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pH", "titrating_residues", "transition_attempt_per_ps", "salt_concentration_M"],
              "properties": {
                "pH":                        {"type": "number", "minimum": 0, "maximum": 14},
                "titrating_residues":        {"type": "array", "minItems": 0, "maxItems": 256, "items": {"type": "string"}},
                "transition_attempt_per_ps": {"type": "number", "minimum": 0, "maximum": 100},
                "salt_concentration_M":      {"type": "number", "minimum": 0, "maximum": 5}
              }
            }
          ]
        },
        "solvent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "ions_NaCl_mM"],
          "properties": {
            "model":        {"enum": ["TIP3P", "TIP4P_EW", "SPC_E", "implicit_GBSA", "vacuum"]},
            "ions_NaCl_mM": {"type": "number", "minimum": 0, "maximum": 5000},
            "membrane": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["composition", "n_lipids", "chol_mol_fraction"],
                  "properties": {
                    "composition":       {"enum": ["POPC", "POPE", "DPPC", "mixed_POPC_chol"]},
                    "n_lipids":          {"type": "integer", "minimum": 8, "maximum": 4096},
                    "chol_mol_fraction": {"type": "number", "minimum": 0, "maximum": 0.5}
                  }
                }
              ]
            }
          }
        }
      }
    },
    "force_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protein", "water", "ligand"],
      "properties": {
        "protein": {"enum": ["amber14sb", "amber99sb_ildn", "amber03", "charmm36m", "opls_aam", "martini3", "martini2_2"]},
        "water":   {"enum": ["TIP3P", "TIP4P_EW", "SPC_E", "implicit_GBSA", "vacuum"]},
        "ligand":  {"enum": ["user_supplied", "gaff2", "openff_sage_2_2_0"]},
        "lipid":   {"oneOf": [{"type": "null"},
                              {"enum": ["charmm36_lipid", "lipid21", "slipids"]}]}
      }
    },
    "protocol": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "max_iterations", "tolerance_kj_mol_nm"],
            "properties": {
              "kind": {"const": "minimize"},
              "max_iterations":      {"type": "integer", "minimum": 1, "maximum": 1000000},
              "tolerance_kj_mol_nm": {"type": "number", "minimum": 0, "maximum": 1e6}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "temperature_ladder_K", "duration_per_replica_ns",
                         "exchange_attempt_period_ps", "ensemble", "pressure_bar",
                         "dt_fs", "thermostat", "friction_ps", "constraints"],
            "properties": {
              "kind":                       {"const": "remd"},
              "temperature_ladder_K":       {"type": "array", "minItems": 2, "maxItems": 64,
                                             "items": {"type": "number", "minimum": 0, "maximum": 1000}},
              "duration_per_replica_ns":    {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
              "exchange_attempt_period_ps": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
              "ensemble":                   {"enum": ["NVT", "NPT"]},
              "pressure_bar":               {"type": ["number", "null"]},
              "dt_fs":                      {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
              "thermostat":                 {"enum": ["langevin", "nose_hoover", "andersen", "berendsen"]},
              "friction_ps":                {"type": "number", "minimum": 0, "maximum": 100},
              "constraints":                {"enum": ["none", "h_bonds", "all_bonds"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "cvs", "bias_height_kj_mol", "bias_deposit_period_ps",
                         "duration_ns", "well_tempered", "bias_factor", "ensemble",
                         "temperature_K", "pressure_bar", "dt_fs", "thermostat",
                         "friction_ps", "constraints"],
            "properties": {
              "kind":                   {"const": "metadynamics"},
              "cvs": {
                "type": "array", "minItems": 1, "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "name", "selection", "reference", "sigma"],
                  "properties": {
                    "kind":      {"enum": ["distance", "angle", "dihedral", "rmsd"]},
                    "name":      {"type": "string", "minLength": 1, "maxLength": 32},
                    "selection": {"type": "string", "minLength": 1},
                    "reference": {"type": ["string", "null"]},
                    "sigma":     {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
                  }
                }
              },
              "bias_height_kj_mol":     {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
              "bias_deposit_period_ps": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
              "duration_ns":            {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
              "well_tempered":          {"type": "boolean"},
              "bias_factor":            {"type": "number", "minimum": 1, "maximum": 100},
              "ensemble":               {"enum": ["NVT", "NPT"]},
              "temperature_K":          {"type": "number", "minimum": 0, "maximum": 1000},
              "pressure_bar":           {"type": ["number", "null"]},
              "dt_fs":                  {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
              "thermostat":             {"enum": ["langevin", "nose_hoover", "andersen", "berendsen"]},
              "friction_ps":            {"type": "number", "minimum": 0, "maximum": 100},
              "constraints":            {"enum": ["none", "h_bonds", "all_bonds"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "fep_kind", "target_selection", "lambda_windows",
                         "duration_per_window_ns", "ensemble", "temperature_K",
                         "pressure_bar", "dt_fs", "thermostat", "friction_ps", "constraints"],
            "properties": {
              "kind":                   {"const": "free_energy"},
              "fep_kind":               {"enum": ["decouple", "annihilate"]},
              "target_selection":       {"type": "string", "minLength": 1},
              "lambda_windows":         {"type": "array", "minItems": 2, "maxItems": 64,
                                         "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "duration_per_window_ns": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
              "ensemble":               {"enum": ["NVT", "NPT"]},
              "temperature_K":          {"type": "number", "minimum": 0, "maximum": 1000},
              "pressure_bar":           {"type": ["number", "null"]},
              "dt_fs":                  {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
              "thermostat":             {"enum": ["langevin", "nose_hoover", "andersen", "berendsen"]},
              "friction_ps":            {"type": "number", "minimum": 0, "maximum": 100},
              "constraints":            {"enum": ["none", "h_bonds", "all_bonds"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "role", "ensemble", "duration_ns", "dt_fs", "temperature_K", "pressure_bar", "thermostat", "barostat", "friction_ps", "constraints", "restraints"],
            "allOf": [
              {
                "if": {"properties": {"ensemble": {"const": "NPT"}}},
                "then": {
                  "properties": {
                    "barostat":     {"enum": ["monte_carlo", "berendsen", "parrinello_rahman"]},
                    "pressure_bar": {"type": "number", "minimum": 0}
                  }
                }
              },
              {
                "if": {"properties": {"ensemble": {"const": "NVE"}}},
                "then": {
                  "properties": {
                    "barostat": {"type": "null"}
                  }
                }
              }
            ],
            "properties": {
              "kind":          {"const": "dynamics"},
              "role":          {"enum": ["equilibrate", "production"]},
              "ensemble":      {"enum": ["NVE", "NVT", "NPT"]},
              "duration_ns":   {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
              "dt_fs":         {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
              "temperature_K": {"type": "number", "minimum": 0, "maximum": 1000},
              "pressure_bar":  {"type": ["number", "null"]},
              "thermostat":    {"enum": ["langevin", "nose_hoover", "andersen", "berendsen"]},
              "barostat":      {"oneOf": [{"enum": ["monte_carlo", "berendsen", "parrinello_rahman"]}, {"type": "null"}]},
              "friction_ps":   {"type": "number", "minimum": 0, "maximum": 100},
              "constraints":   {"enum": ["none", "h_bonds", "all_bonds"]},
              "restraints": {
                "type": "object",
                "additionalProperties": false,
                "required": ["selection", "kind", "k_kj_mol_nm2"],
                "properties": {
                  "selection":    {"enum": ["heavy_atoms", "backbone", "ca", "none"]},
                  "kind":         {"enum": ["harmonic", "flat_bottom"]},
                  "k_kj_mol_nm2": {"type": "number", "minimum": 0, "maximum": 1e6}
                }
              }
            }
          }
        ]
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "selection", "stride_ps"],
        "properties": {
          "type":      {"enum": ["rmsd", "rmsf", "energy", "trajectory", "rg"]},
          "selection": {"type": "string"},
          "stride_ps": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "cite", "confidence"],
        "properties": {
          "source":     {"enum": ["paper", "paper_default", "assumed", "user", "runtime_default"]},
          "cite":       {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "notes":    {"type": "string"}
  }
}
